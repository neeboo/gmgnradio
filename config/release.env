# Make environment configuration: values containing spaces must not be quoted.
# Increment the build number before publishing a new formal package.
GMGN_RELEASE_BUILD ?= 226
GMGN_RELEASE_VERSION ?= 0.1.0
CARGO_INCREMENTAL ?= 0
CARGO_BUILD_JOBS ?= 1
CARGO_NET_OFFLINE ?= true
CONFIGURATION ?= Release
INSTALL_DESTINATION ?= $(HOME)/Applications/gmgn radio.app
TASK_SERVICE_ROOT ?= $(HOME)/Library/Application Support/gmgn radio/TaskService

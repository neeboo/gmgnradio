{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmgn.radio/contracts/dj-tools.schema.json",
  "title": "gmgn radio DJ tool protocol",
  "oneOf": [
    {
      "$ref": "#/$defs/invocation"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "toolName": {
      "enum": [
        "search_music",
        "replace_upcoming_queue",
        "play_track",
        "skip_track",
        "set_music_gain",
        "remember_preference",
        "forget_current_context",
        "set_conversation_mode",
        "enter_immersive_visuals",
        "end_program"
      ]
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "idempotency_key",
        "arguments"
      ],
      "properties": {
        "type": {
          "const": "invocation"
        },
        "name": {
          "$ref": "#/$defs/toolName"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "arguments": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "search_music"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/searchMusicArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "replace_upcoming_queue"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/replaceQueueArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "play_track"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/playTrackArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "skip_track"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/skipTrackArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "set_music_gain"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/setMusicGainArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "remember_preference"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/rememberPreferenceArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "forget_current_context"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/forgetContextArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "set_conversation_mode"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/setConversationModeArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "enter_immersive_visuals"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/immersiveArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "end_program"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/endProgramArguments"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "idempotency_key",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "name": {
          "$ref": "#/$defs/toolName"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "data": {},
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "data"
          ]
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "searchMusicArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      }
    },
    "replaceQueueArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_ids"
      ],
      "properties": {
        "track_ids": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "playTrackArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "skipTrackArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "setMusicGainArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gain"
      ],
      "properties": {
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ramp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "default": 250
        }
      }
    },
    "rememberPreferenceArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forgetContextArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "conversation",
            "situation"
          ]
        }
      }
    },
    "setConversationModeArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "quiet",
            "ambient",
            "conversational"
          ]
        }
      }
    },
    "immersiveArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "endProgramArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}

  "RemeshMesh": {
    "input": {
      "required": {
        "mesh": [
          "MESH",
          {}
        ],
        "resolution": [
          "INT",
          {
            "tooltip": "Voxel grid resolution (output density). 256 ~ 100k faces, 512 ~ 1M. For an exact face count, follow with Decimate Mesh.",
            "default": 512,
            "min": 32,
            "max": 2048
          }
        ],
        "sign_mode": [
          "COMFY_DYNAMICCOMBO_V3",
          {
            "display_name": "sign_mode",
            "tooltip": "udf: robust to messy/non-manifold input. sdf: clean single surface with QEF (Quadratic Error Function) sharp-feature recovery, but needs consistent winding.",
            "options": [
              {
                "key": "udf",
                "inputs": {
                  "required": {
                    "qef": [
                      "BOOLEAN",
                      {
                        "tooltip": "QEF (Quadratic Error Function) dual-vertex placement for sharper edges.",
                        "advanced": true,
                        "default": false
                      }
                    ],
                    "drop_inverted_components": [
                      "BOOLEAN",
                      {
                        "tooltip": "Drop inward-normal (negative-volume) closed components — the UDF inner shell.",
                        "advanced": true,
                        "default": false
                      }
                    ],
                    "drop_enclosed_components": [
                      "BOOLEAN",
                      {
                        "tooltip": "Drop components inside the largest's bbox that fail a point-in-mesh raycast. Disable for legitimate nested parts.",
                        "advanced": true,
                        "default": false
                      }
                    ]
                  }
                }
              },
              {
                "key": "sdf",
                "inputs": {
                  "required": {
                    "qef": [
                      "BOOLEAN",
                      {
                        "tooltip": "QEF (Quadratic Error Function) dual-vertex placement (recovers sharp features) vs edge-crossing centroid.",
                        "default": true
                      }
                    ],
                    "manifold": [
                      "BOOLEAN",
                      {
                        "tooltip": "Manifold Dual Contouring: 1-4 dual verts/voxel for multi-sheet cases. Slower.",
                        "default": false
                      }
                    ]
                  }
                }
              }
            ]
          }
        ],
        "band": [
          "FLOAT",
          {
            "tooltip": "Narrow-band width in voxel units. In UDF mode also offsets the surface.",
            "advanced": true,
            "default": 1,
            "min": 0.5,
            "max": 4,
            "step": 0.1
          }
        ],
        "project_back": [
          "FLOAT",
          {
            "tooltip": "Linearly interpolate vertices toward the original surface (0 = pure DC, 1 = snapped).",
            "advanced": true,
            "default": 0,
            "min": 0,
            "max": 1,
            "step": 0.05
          }
        ],
        "fix_poles": [
          "BOOLEAN",
          {
            "tooltip": "Collapse valence-3 vertex pairs (DC T-junction artifact).",
            "advanced": true,
            "default": false
          }
        ],
        "smooth_iters": [
          "INT",
          {
            "tooltip": "Taubin smoothing iterations (0 = off). 2-3 cleans DC staircase-like artifacts; higher over-smooth QEF edges.",
            "default": 0,
            "min": 0,
            "max": 20
          }
        ],
        "drop_small_components": [
          "FLOAT",
          {
            "tooltip": "Drop components below this fraction of the largest's face count. 0 disables.",
            "advanced": true,
            "default": 0.01,
            "min": 0,
            "max": 0.5,
            "step": 0.005
          }
        ],
        "precluster_max_verts": [
          "INT",
          {
            "tooltip": "Cap input vertex count before the field queries, inputs above this are cluster-decimated to it first. Prevents OOM on huge meshes.",
            "advanced": true,
            "default": 20000000,
            "min": 0,
            "max": 100000000
          }
        ]
      },
      "hidden": {
        "unique_id": [
          "UNIQUE_ID"
        ]
      }
    },
    "input_order": {
      "required": [
        "mesh",
        "resolution",
        "sign_mode",
        "band",
        "project_back",
        "fix_poles",
        "smooth_iters",

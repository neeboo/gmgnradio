:root { --text: #f1f2f5; --muted: #aeb4c1; --panel: rgba(14, 17, 21, 0.96); --line: #343b42; --accent: #37cbea; --body: 14px; --caption: 12px; --subtitle: 16px; --title: 20px; }
.document-root { height: 100%; flex-grow: 1; }
.shell { height: 100%; flex-grow: 1; padding: 24px; color: var(--text); font-size: var(--body); }
.header { height: 40px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; }
.muted { color: var(--muted); }
.status { max-width: 560px; white-space: normal; font-size: var(--caption); margin-right: 16px; }
.status-error { color: #ff9c94; }
.mode { flex-direction: row; align-items: center; justify-content: center; min-width: 128px; border-radius: 24px; padding: 8px 16px; border-color: var(--accent); color: var(--accent); border-width: 1px; white-space: nowrap; }
.mode .toolbar-icon { margin-right: 8px; }
.button-label { white-space: nowrap; flex-shrink: 0; -unity-text-align: middle-center; }
.body { flex-grow: 1; min-height: 0; justify-content: flex-end; align-items: flex-end; }
.card { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 16px; padding: 16px; }
.wish-panel { width: 440px; max-width: 100%; height: 380px; max-height: 80%; min-height: 0; flex-shrink: 1; margin-bottom: 16px; overflow: hidden; }
.wish-header { flex-direction: row; align-items: center; height: 36px; flex-shrink: 0; margin-bottom: 8px; }
.wish-title { flex-grow: 1; min-width: 0; font-size: var(--subtitle); -unity-font-style: bold; }
.wish-notice { flex-shrink: 0; color: var(--muted); font-size: var(--caption); white-space: normal; margin-bottom: 8px; }
.wish-list { height: 0; min-height: 0; min-width: 0; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.wish-list .unity-scroll-view__content-viewport { min-width: 0; overflow: hidden; }
.wish-list .unity-scroll-view__content-container { min-width: 0; }
.wish-row { flex-direction: row; align-items: center; width: 100%; height: 68px; min-width: 0; padding: 8px 12px; background-color: #1b2026; border-radius: 8px; overflow: hidden; }
.wish-info { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.wish-name { min-width: 0; max-width: 100%; flex-shrink: 1; font-size: var(--body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wish-stage { font-size: var(--caption); color: var(--muted); margin-top: 4px; }
.wish-action { width: 36px; height: 36px; padding: 8px; margin-left: 8px; flex-shrink: 0; background-color: #083b51; color: var(--accent); }
.wish-footer { flex-shrink: 0; margin-top: 12px; }
.wish-create { flex-direction: row; align-items: center; justify-content: center; background-color: #1b2026; }
.wish-create .toolbar-icon { margin-right: 8px; }
.wish-create Label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lyrics { position: absolute; left: 0; right: 0; top: 44%; padding: 16px; }
.lyric { font-size: 30px; -unity-text-align: middle-center; white-space: normal; color: var(--accent); }
.translation { font-size: var(--subtitle); -unity-text-align: middle-center; white-space: normal; margin-top: 12px; color: var(--muted); }
.row { flex-direction: row; align-items: center; }
.subtitle { font-size: var(--subtitle); flex-grow: 1; }
Button { font-size: var(--body); height: 36px; padding: 8px 12px; margin: 0; background-color: transparent; color: var(--text); border-width: 0; border-radius: 8px; flex-shrink: 0; }
Button:hover { background-color: #282e35; }
Button.primary, Button.selected { background-color: #083b51; color: var(--accent); }
Button:disabled { opacity: 0.4; }
.icon-button { width: 36px; height: 36px; padding: 8px; margin-right: 4px; align-items: center; justify-content: center; }
.toolbar-icon { width: 20px; height: 20px; flex-shrink: 0; }
.settings-button { flex-direction: row; align-items: center; min-width: 84px; white-space: nowrap; }
.settings-button .toolbar-icon { margin-right: 8px; }
.player { width: 760px; max-width: 100%; flex-shrink: 0; padding: 8px 12px; }
.track-row { height: 24px; }
.track-title { font-size: var(--body); max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.artist { font-size: var(--caption); margin-left: 12px; flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.time { font-size: var(--caption); margin-left: 8px; flex-shrink: 0; }
.toolbar { flex-wrap: nowrap; }
.lyrics-toggle { margin-right: 6px; }
.toolbar-spacer { flex-grow: 1; }
.separator { width: 1px; height: 20px; background-color: var(--line); margin: 0 8px; }
.volume { width: 96px; margin-left: 8px; margin-right: 8px; }
.chat-column { width: 620px; max-width: 100%; height: 360px; max-height: 84%; min-height: 0; flex-shrink: 1; margin-bottom: 16px; overflow: hidden; }
.chat-header { flex-shrink: 0; height: 32px; margin-bottom: 8px; }
.empty-chat { white-space: normal; font-size: var(--body); margin-bottom: 8px; }
.unity-list-view__empty-label, .unity-collection-view__empty-label { display: none; }
.messages { height: 0; flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; margin-bottom: 8px; overflow: hidden; }
.messages .unity-scroll-view__content-viewport { min-width: 0; overflow: hidden; }
.messages .unity-scroll-view__content-container { min-width: 0; height: auto; flex-shrink: 0; align-items: stretch; }
.message { width: 100%; max-width: 100%; min-width: 0; flex-shrink: 0; padding: 8px 12px; margin-bottom: 8px; background-color: #1b2026; border-radius: 8px; }
.message-role { font-size: var(--caption); color: var(--accent); margin-bottom: 4px; flex-shrink: 0; }
.message-text { min-width: 0; max-width: 100%; flex-shrink: 1; font-size: var(--body); white-space: normal; }
.message-error .message-text { color: #ffb4ad; }
.retry-message { align-self: flex-start; margin-top: 8px; height: 32px; color: var(--accent); }
.draft { height: 72px; min-height: 72px; max-height: 72px; flex-shrink: 0; font-size: var(--body); margin: 0; }
.draft .unity-text-field__input { height: 100%; flex-grow: 1; flex-shrink: 1; align-self: stretch; padding: 4px 12px; background-color: #13161b; color: var(--text); border-width: 1px; border-color: var(--line); border-radius: 8px; white-space: normal; }
.chat-composer { flex-shrink: 0; background-color: #13161b; border-width: 1px; border-color: var(--line); border-radius: 12px; padding: 4px; }
.chat-composer .draft .unity-text-field__input { border-width: 0; background-color: transparent; }
.composer-footer { height: 40px; min-height: 40px; max-height: 40px; margin-top: 0; flex-grow: 0; flex-shrink: 0; }
.composer-spacer { flex-grow: 1; }
.chat-attachment-button { font-size: 24px; -unity-text-align: middle-center; padding: 0; }
.hint { font-size: var(--caption); flex-grow: 1; white-space: normal; }
.hidden { display: none; }
.chat-voice-status { flex-grow: 0; flex-shrink: 0; white-space: normal; font-size: var(--caption); margin-top: 4px; }
Slider { height: 20px; margin: 0; flex-direction: row; align-items: center; }
Slider .unity-base-field__input { height: 20px; min-width: 40px; flex-grow: 1; position: relative; }
.unity-base-slider__input { height: 20px; min-width: 40px; flex-grow: 1; position: relative; }
.unity-base-slider__tracker { position: absolute; height: 3px; top: 9px; left: 0; right: 0; background-color: #64707d; border-radius: 2px; }
.unity-base-slider__dragger { position: absolute; width: 10px; height: 10px; top: 5px; background-color: var(--accent); border-radius: 5px; }
.unity-base-slider__dragger-border { display: none; }
Slider:disabled { opacity: 0.4; }
.compact .shell { padding: 12px; }
.compact .lyrics { top: 32%; }
.compact .chat-column { height: 360px; margin-bottom: 8px; }
.compact .lyric { font-size: 24px; }
.compact .player { padding: 6px 8px; }
.compact .toolbar .icon-button { width: 32px; height: 32px; padding: 6px; margin-right: 2px; }
.compact .toolbar .settings-button { min-width: 72px; padding: 6px 8px; }
.compact .toolbar .volume { width: 64px; margin-left: 6px; margin-right: 6px; }
.compact .toolbar .separator { margin: 0 6px; }
.restore-window { display: none; }
.livecam-controls, .livecam-player-menu, .compact-only { display: none; }
.compact-window .shell { padding: 0; }
.compact-window .header { display: none; }
.compact-window .lyrics { display: none; }
.compact-window .player { display: none; }
.compact-window .livecam-controls { display: flex; position: absolute; top: 10px; right: 10px; width: 30px; }
.compact-window .livecam-controls .icon-button { width: 30px; height: 30px; padding: 7px; margin: 0 0 6px 0; background-color: rgba(14,17,21,0.72); }
.compact-window .livecam-controls .toolbar-icon { width: 16px; height: 16px; }
.compact-window .livecam-player-menu { display: flex; position: absolute; top: 46px; right: 48px; width: 116px; padding: 4px; flex-direction: row; }
.compact-window .livecam-player-menu.hidden { display: none; }
.compact-window .livecam-player-menu .icon-button { width: 32px; height: 30px; margin: 0; padding: 6px; }
.compact-window .chat-column { position: absolute; left: 8px; right: 48px; bottom: 8px; width: auto; height: 244px; max-height: 92%; flex-grow: 0; padding: 8px; margin: 0; background-color: rgba(14,17,21,0.98); }
.compact-window .chat-column.compact-history { height: 320px; }
.compact-window .chat-header { height: 28px; margin-bottom: 6px; }
.compact-window .chat-header .subtitle { display: flex; flex-grow: 1; min-width: 0; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.compact-window .compact-only { display: flex; }
.compact-window .chat-header .icon-button, .compact-window .composer-footer .icon-button { width: 28px; height: 28px; padding: 6px; margin: 0; }
.compact-window .chat-header .toolbar-icon, .compact-window .composer-footer .toolbar-icon { width: 16px; height: 16px; }
.compact-window .empty-chat { display: none; }
.compact-window .messages { height: 0; flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 6px; }
.compact-window .new-messages { position: absolute; top: 26px; left: 6px; right: 6px; height: 24px; font-size: 11px; }
.compact-window .message { padding: 4px 6px; margin-bottom: 4px; }
.compact-window .message-role { display: none; }
.compact-window .message-text { font-size: 12px; }
.compact-window .draft { height: 72px; min-height: 72px; max-height: 72px; font-size: 12px; }
.compact-window .draft .unity-text-field__input { padding: 4px 6px; }
.compact-window .composer-footer { height: 28px; min-height: 28px; max-height: 28px; margin-top: 0; }
.compact-window .hint { display: none; }
.compact-window .chat-voice-status { display: flex; font-size: 10px; max-height: 24px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chat-voice-status.hidden, .compact-window .chat-voice-status.hidden { display: none; }
.chat-image-drafts { height: 72px; max-height: 72px; flex-grow: 0; flex-shrink: 0; margin-bottom: 4px; }
.chat-image-drafts.hidden { display: none; }
.chat-image-row { flex-direction: row; align-items: center; height: 48px; min-height: 48px; flex-shrink: 0; }
.chat-image-thumbnail { width: 44px; height: 44px; flex-shrink: 0; margin-right: 6px; }
.chat-image-filename { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.chat-image-remove { flex-shrink: 0; height: 24px; padding: 2px 5px; margin: 0; font-size: 11px; }
.compact-window .chat-column.chat-has-images { height: 280px; }
.compact-window .chat-column.chat-has-images.compact-history { height: 320px; }
.compact-window .chat-image-drafts { height: 36px; max-height: 36px; margin-bottom: 2px; }
.compact-window .chat-image-row { height: 32px; min-height: 32px; }
.compact-window .chat-image-thumbnail { width: 28px; height: 28px; margin-right: 4px; }
.compact-window .chat-image-filename { font-size: 10px; }
.compact-window .chat-image-remove { font-size: 10px; height: 20px; padding: 1px 3px; }
.compact-window .composer-footer { justify-content: flex-end; }
.compact-window .body .inbox-panel { position: absolute; left: 8px; right: 48px; bottom: 8px; width: auto; height: 280px; max-height: 94%; padding: 8px; margin: 0; }
.compact-window .inbox-header .inbox-title { font-size: 12px; }
.compact-window .inbox-row { padding: 4px; }
.inbox-unread-badge {
    position: absolute;
    right: 1px;
    top: 1px;
    min-width: 14px;
    height: 14px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 7px;
    background-color: #e54b4b;
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}
.ime-composing .unity-text-element {
    --unity-cursor-color: transparent;
}

:root { --text: #f1f2f5; --muted: #aeb4c1; --panel: rgba(20, 24, 34, 0.94); --line: #343b4c; --accent: #59cce8; }
.document-root { height: 100%; flex-grow: 1; }
.shell { height: 100%; flex-grow: 1; flex-direction: column; padding: 24px; color: var(--text); font-size: 16px; }
.header { height: 48px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.heading { font-size: 20px; -unity-font-style: bold; margin-bottom: 8px; }
.muted { color: var(--muted); }
.status { max-width: 620px; white-space: normal; margin-left: 24px; }
.status-error { color: #ff9c94; }
.empty-chat { white-space: normal; margin-top: 20px; }
.unity-list-view__empty-label { display: none; }
.unity-collection-view__empty-label { display: none; }
.body { flex-direction: row; align-items: stretch; flex-grow: 1; min-height: 640px; }
.stage-column { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 640px; margin-right: 24px; }
.stage-space { flex-grow: 1; min-height: 300px; }
.card { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 16px; padding: 20px; }
.lyrics { padding: 20px; height: 140px; flex-shrink: 0; }
.lyric { font-size: 30px; -unity-text-align: middle-center; white-space: normal; color: var(--accent); }
.translation { font-size: 16px; -unity-text-align: middle-center; white-space: normal; margin-top: 12px; color: var(--muted); }
.row { flex-direction: row; align-items: center; margin-top: 12px; }
Button { font-size: 16px; min-height: 38px; padding: 8px 16px; margin-right: 8px; background-color: #252c3a; color: var(--text); border-width: 1px; border-color: var(--line); border-radius: 8px; }
Button:hover { background-color: #344053; }
Button.primary { background-color: #23657b; }
Button:disabled { color: #77808e; }
.time { flex-grow: 1; margin-left: 8px; }
.volume { width: 180px; }
.chat-column { flex-direction: column; width: 380px; flex-shrink: 0; min-height: 640px; }
.messages { flex-grow: 1; flex-shrink: 1; min-height: 300px; margin: 12px 0; }
.message { padding: 12px; margin-bottom: 12px; background-color: #252b37; border-radius: 10px; }
.message-role { font-size: 13px; color: var(--accent); margin-bottom: 6px; }
.message-text { font-size: 16px; white-space: normal; }
.draft { height: 100px; flex-shrink: 0; font-size: 16px; }
.draft .unity-text-field__input { padding: 12px; background-color: #151923; color: var(--text); border-width: 1px; border-color: var(--line); border-radius: 8px; white-space: normal; }
.hint { font-size: 12px; flex-grow: 1; white-space: normal; }
.hidden { display: none; }
.player { height: 190px; flex-shrink: 0; }
Slider { min-height: 24px; margin-top: 10px; flex-direction: row; align-items: center; }
.unity-base-slider__input { height: 24px; min-width: 80px; flex-grow: 1; align-items: center; position: relative; }
.unity-base-slider__tracker { position: absolute; height: 4px; top: 10px; left: 0; right: 0; background-color: #657185; border-radius: 2px; }
.unity-base-slider__dragger { position: absolute; width: 14px; height: 14px; top: 5px; background-color: var(--accent); border-radius: 7px; }
.unity-base-slider__dragger-border { position: absolute; width: 16px; height: 16px; top: 4px; border-width: 1px; border-color: #b2edfa; border-radius: 8px; }
Slider:disabled .unity-base-slider__dragger { background-color: #8995a6; }
Slider .unity-base-field__label { min-width: 38px; margin-right: 8px; }

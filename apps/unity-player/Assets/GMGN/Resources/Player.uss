.document-root { height:100%; flex-grow:1; }
.shell { height:100%; flex-grow:1; }
.body { flex-grow:1; min-height:0; }
.lyrics { position:absolute; left:0; right:0; top:44%; padding:16px; }
.lyric { font-size:30px; -unity-text-align:middle-center; white-space:normal; color:#37cbea; }
.translation { font-size:16px; -unity-text-align:middle-center; white-space:normal; margin-top:12px; color:#aeb4c1; }
.compact-window .lyrics { display:none; }

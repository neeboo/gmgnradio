.music-library { width: 440px; max-width: 100%; height: 470px; max-height: 84%; min-height: 0; flex-shrink: 1; margin-bottom: 16px; padding: 16px; overflow: hidden; }
.music-library-header { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.music-library-title { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: var(--subtitle); -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.music-library-count { flex-shrink: 0; font-size: var(--caption); white-space: nowrap; margin-left: 4px; }
.music-library-action { width: 32px; min-width: 32px; max-width: 32px; height: 32px; flex-shrink: 0; padding: 6px; margin: 0 0 0 4px; align-items: center; justify-content: center; }
.music-library-status { font-size: var(--caption); color: var(--muted); white-space: normal; margin-bottom: 10px; flex-shrink: 0; }
.music-library-list-region { height: 0; flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.music-library-list { height: 0; flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.music-library-list .unity-scroll-view { flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.music-library-viewport { flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.music-library-content { min-width: 0; align-items: stretch; }
.music-library-playlist-slot { height: 84px; min-height: 84px; max-height: 84px; flex-shrink: 0; min-width: 0; margin: 0; padding: 0 0 8px 0; overflow: hidden; }
.music-library-track-slot { height: 64px; min-height: 64px; max-height: 64px; flex-shrink: 0; min-width: 0; margin: 0; padding: 0 0 6px 0; overflow: hidden; }
.music-library-playlist { height: 76px; min-height: 76px; max-height: 76px; flex-shrink: 0; min-width: 0; padding: 12px; margin: 0; flex-direction: row; align-items: center; border-radius: 18px; border-width: 1px; border-color: var(--line); background-color: rgba(40, 44, 50, 0.86); }
.music-library-track { height: 58px; min-height: 58px; max-height: 58px; flex-shrink: 0; min-width: 0; padding: 8px 12px; margin: 0; flex-direction: row; align-items: center; border-radius: 12px; background-color: rgba(40, 44, 50, 0.65); }
.music-library-cover { width: 44px; height: 44px; margin-right: 12px; border-radius: 12px; overflow: hidden; background-color: rgba(120, 70, 70, 0.2); flex-shrink: 0; }
.music-library-info { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.music-library-name { font-size: var(--body); -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.music-library-secondary { font-size: var(--caption); color: var(--muted); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.music-library-trailing { font-size: var(--caption); color: var(--muted); margin-left: 8px; flex-shrink: 0; }
.music-library-playlist > .music-library-trailing { font-size: 22px; }
.music-library-number { width: 24px; margin-right: 8px; color: var(--muted); font-size: var(--caption); flex-shrink: 0; }
.music-library-current { background-color: #083b51; }
.music-library-current .music-library-name, .music-library-current .music-library-trailing { color: var(--accent); }
.music-library-detail { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.compact .music-library { height: 330px; margin-bottom: 8px; }
.compact .music-library { padding: 10px; }
.compact .music-library-title { font-size: 13px; }
.compact .music-library-count { font-size: 11px; margin-left: 2px; }
.compact .music-library-action { width: 26px; min-width: 26px; max-width: 26px; height: 28px; padding: 4px; margin-left: 2px; }

.inventory-panel { width: 416px; max-width: 92%; min-height: 0; flex-shrink: 1; overflow: hidden; padding: 18px; background-color: rgba(13, 18, 23, 0.98); border-width: 1px; border-color: #35434b; border-radius: 18px; color: #e8edef; }
.inventory-header { flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.inventory-title { flex-grow: 1; font-size: var(--subtitle); -unity-font-style: bold; }
.inventory-close { width: 36px; height: 36px; margin: 0; padding: 0; border-width: 0; border-radius: 10px; background-color: #202b32; color: #b9c5cc; font-size: 24px; }
.inventory-close:hover { background-color: #34434d; color: white; }
.inventory-scroll { height: 0; flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.inventory-viewport { flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; overflow: hidden; }
.inventory-content { min-width: 0; align-items: stretch; }
.inventory-section { margin-top: 14px; margin-bottom: 8px; font-size: var(--caption); color: #8497a3; -unity-font-style: bold; }
.inventory-essential { flex-direction: row; align-items: center; padding: 12px; margin-bottom: 6px; border-radius: 12px; background-color: #182229; flex-shrink: 0; }
.inventory-symbol { width: 36px; height: 36px; margin-right: 10px; color: #38cee5; font-size: 24px; -unity-text-align: middle-center; flex-shrink: 0; }
.inventory-info { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.inventory-name { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: var(--body); -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inventory-detail { margin-top: 5px; font-size: var(--caption); color: #8da0ac; white-space: normal; }
.inventory-card { margin-bottom: 8px; padding: 14px; background-color: #1b262e; border-width: 1px; border-color: #2b3a44; border-radius: 12px; flex-shrink: 0; }
.inventory-card-heading { flex-direction: row; align-items: center; }
.inventory-badge { flex-shrink: 0; margin-left: 10px; padding: 4px 8px; border-radius: 6px; font-size: var(--caption); }
.inventory-placed { color: #a8d6c6; background-color: #243c36; }
.inventory-stored { color: #b3c2ce; background-color: #303e49; }
.inventory-held { color: #e4c896; background-color: #42392b; }
.inventory-actions { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12px; }
.inventory-primary { height: 36px; min-width: 74px; margin: 0; padding: 0 14px; border-width: 1px; border-color: #205264; border-radius: 8px; background-color: #123846; color: #50d2e7; font-size: var(--body); }
.inventory-primary:hover { background-color: #1d4e5e; border-color: #38cee5; }
.inventory-primary:disabled { background-color: #263139; border-color: #33414b; color: #657780; }
.inventory-delete { height: 36px; min-width: 74px; margin: 0 0 0 12px; padding: 0 10px; border-width: 0; border-radius: 8px; background-color: transparent; color: #99a8b1; font-size: var(--caption); }
.inventory-delete:hover { color: #f0a59c; background-color: #422d30; }
.inventory-delete-confirm { color: #ffb0a5; background-color: #4b3034; }
.inventory-delete:disabled { color: #596b77; }
.inventory-empty { padding: 24px 12px; color: #8da0ac; font-size: var(--body); white-space: normal; -unity-text-align: middle-center; }

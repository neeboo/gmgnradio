<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Player.uss" />
  <ui:VisualElement class="shell">
    <ui:VisualElement class="header">
      <ui:Label text="GMGN · 音乐与角色" class="heading" />
      <ui:Label name="status" text="正在连接音乐与对话服务…" class="status muted" />
    </ui:VisualElement>
    <ui:VisualElement class="body">
      <ui:VisualElement class="stage-column">
        <ui:VisualElement class="stage-space" picking-mode="Ignore" />
        <ui:VisualElement class="lyrics">
          <ui:Label name="lyric" text="播放音乐后，歌词将在这里显示" class="lyric" />
          <ui:Label name="translation" class="translation" />
        </ui:VisualElement>
        <ui:VisualElement class="player card">
          <ui:Label name="track" text="尚未播放" class="heading" />
          <ui:Label name="artist" class="muted" />
          <ui:Slider name="seek" low-value="0" high-value="1" />
          <ui:VisualElement class="row">
            <ui:Button name="chooseMusic" text="打开音乐" />
            <ui:Button name="play" text="播放" />
            <ui:Button name="next" text="下一首" />
            <ui:Label name="time" text="0:00 / 0:00" class="time muted" />
            <ui:Slider name="volume" label="音量" low-value="0" high-value="1" value="0.8" class="volume" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="chat-column card">
        <ui:Label text="与角色聊天" class="heading" />
        <ui:Label name="emptyChat" text="可以聊音乐，也可以和角色说说今天的事。" class="empty-chat muted" />
        <ui:ListView name="messages" virtualization-method="DynamicHeight" selection-type="None" class="messages" />
        <ui:Button name="newMessages" text="查看新消息 ↓" class="hidden" />
        <ui:TextField name="draft" multiline="true" class="draft" />
        <ui:VisualElement class="row">
          <ui:Label text="Enter 发送 · Shift+Enter 换行" class="hint muted" />
          <ui:Button name="cancel" text="停止" />
          <ui:Button name="send" text="发送" class="primary" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>

+    def test_size_intent_is_optional_strict_and_echoed(self):
+        # 缺失 ⇒ 键根本不出现：老调用方看到的回执与今天逐字节相同。
+        job = self.store.submit("intent-absent", self.request())
+        self.assertNotIn("size_intent", job)
+        # 合法意图随任务**落盘**并原样回显（重开一个 store 也一样）。
+        intent = {"axis": "longest", "meters": 1.1, "source": "user"}
+        job = self.store.submit("intent-longest", self.request(size_intent=intent))
+        self.assertEqual(job["size_intent"], intent)
+        self.assertEqual(self.store.get(job["id"])["size_intent"], intent)
+        reopened = service.JobStore(Path(self.temp.name))
+        self.addCleanup(reopened.close)
+        self.assertEqual(reopened.get(job["id"])["size_intent"], intent)
+        # `axis == "height"` 与 `height_meters`（这里 0.12）是同一件事：一致才行。
+        agreed = {"axis": "height", "meters": 0.12, "source": "user"}
+        self.assertEqual(self.store.submit("intent-height", self.request(size_intent=agreed))["size_intent"], agreed)
+        with self.assertRaisesRegex(service.APIError, "size_intent_conflict"):
+            self.store.submit("intent-height-conflict",
+                              self.request(size_intent={"axis": "height", "meters": 0.5, "source": "user"}))
